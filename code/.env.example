# Browser-safe token for map rendering and temporary address search.
# Restrict it by allowed URL and minimum required Mapbox scopes.
VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=/api

# Server-only token. Never prefix this with VITE_.
MAPBOX_SERVER_TOKEN=
MELBOURNE_OPEN_DATA_BASE_URL=https://data.melbourne.vic.gov.au/api/explore/v2.1/catalog/datasets
LIVE_DATA_ENABLED=false

# Server-only pooled Neon PostgreSQL connection string.
# Configure this as DATABASE_URL in Vercel. Never prefix it with VITE_.
DATABASE_URL=

# Public frontend origin used for production API CORS, for example
# https://calmpath-melbourne.vercel.app
APP_ORIGIN=
